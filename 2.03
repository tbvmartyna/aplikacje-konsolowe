namespace ConsoleApp3
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Podaj pierwszą ocenę: ");
            double ocena1 = int.Parse(Console.ReadLine());
            Console.Write("Podaj drugą ocenę: ");
            double ocena2 = int.Parse(Console.ReadLine());
            Console.Write("Podaj trzecią ocenę: ");
            double ocena3 = int.Parse(Console.ReadLine());
            double srednia = ((ocena1 + ocena2 + ocena3) / 3);
            Console.WriteLine($"Średnia ocen wynosi: {srednia}");
        }
    }
}
